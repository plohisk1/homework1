n = int(input("Введите количество чисел: "))

max1 = max2 = 0 # два наибольших: max1 — максимум, max2 — второе наибольшее
for i in range(n):
    x = int(input(f"Введите число {i + 1}: "))
    if x > max1:
        max2 = max1
        max1 = x
    elif x > max2:
        max2 = x

print("Наибольшее:", max1)
print("Второе по величине:", max2)
