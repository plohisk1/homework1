print("Возможные варианты покупки:")
# Перебираем количество быков (b). Максимум 10, так как 1 бык стоит 10 руб.
for b in range(0, 11):
    # Перебираем количество коров (k). Максимум 20, так как 1 корова стоит 5 руб.
    for k in range(0, 21):
        # Перебираем количество телят (t). Максимум 200, так как 1 теленок стоит 0.5 руб.
        for t in range(0, 201):
            # Проверяем условие: сумма равна 100 и куплено хотя бы одно животное
            if (10 * b + 5 * k + 0.5 * t == 100) and (b + k + t >= 1):
                print(f"Быков: {b}, Коров: {k}, Телят: {t}")
