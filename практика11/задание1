# Перебираем количество месяцев по 28 дней (n)
for n in range(1, 13):
    # Перебираем количество месяцев по 30 дней (k)
    for k in range(1, 13):
        # Перебираем количество месяцев по 31 дню (m)
        for m in range(1, 13):
            # Проверяем, удовлетворяет ли комбинация уравнению
            if 28 * n + 30 * k + 31 * m == 365:
                # Если да, выводим результат
                print(f"n = {n}, k = {k}, m = {m}")
