
import math

def calculate_distance(x1, y1, x2, y2):
    """Вычисляет расстояние между двумя точками на плоскости."""
    return math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)

def calculate_triangle_area(a, b, c):
    """Вычисляет площадь треугольника по формуле Герона."""
    p = (a + b + c) / 2
    return math.sqrt(p * (p - a) * (p - b) * (p - c))


x1, y1 = map(float, input("Координаты точки A (x y): ").split())
x2, y2 = map(float, input("Координаты точки B (x y): ").split())
x3, y3 = map(float, input("Координаты точки C (x y): ").split())

ab = calculate_distance(x1, y1, x2, y2)
bc = calculate_distance(x2, y2, x3, y3)
ac = calculate_distance(x1, y1, x3, y3)

area = calculate_triangle_area(ab, bc, ac)
print("Площадь треугольника:", f"{area:.2f}")