c1 = int(input("Столбец первой клетки: "))
r1 = int(input("Строка первой клетки: "))
c2 = int(input("Столбец второй клетки: "))
r2 = int(input("Строка второй клетки: "))

# Ферзь ходит по прямой: по горизонтали/вертикали
# либо по диагонали
if c1 == c2 or r1 == r2 or abs(c1 - c2) == abs(r1 - r2):
    print("YES")
else:
    print("NO")
