import random

status = input("Введите статус заказа (в ожидании, в обработке, отправлено, доставлено, отменено): ")
""" статус, его эмодзи, этап и время ожидания через рандом от одного числа до другого """
match status:

    case "в ожидании":
        name, emoji, stage, time = ("В ожидании", "⏳", "заказ ждёт подтверждения оплаты", (52, 67, "мин")) #через рандом число от 52 до 67 в минутах
        
    case "в обработке":
        name, emoji, stage, time = ( "В обработке", "⚙️", "заказ собирается на складе", (1, 5, "ч"))        #через рандом число от 1 до 5 в часах
        
    case "отправлено":
        name, emoji, stage, time = ("Отправлено", "📦", "заказ в пути к получателю", (1, 7, "дн."))         #через рандом число от 1 до 7 в днях
        
    case "доставлено":
        name, emoji, stage, time = ("Доставлено", "✅", "заказ получен получателем", (0, 0, ""))            #доставлено

    case "отменено":
        name, emoji, stage, time = ("Отменено", "❌", "заказ отменён, обработка завершена", (0, 0, ""))     #отмена
        
    case _:                                                                        
        name = None                                                                                          #неизвестный код статуса

if name is not None:
    """ примерное время ожидания через рандом от числа до числа, а юнит это единиица измерения сверху """
    lo, hi, unit = time
    wait = f"готово" if hi == 0 else f"{random.randint(lo, hi)} {unit}"            #проверка на нуль, патамушта заказ может быть доставленным или отмененным
    print("=" * 100)
    print(f"  Статус заказа: {name} {emoji}")
    print(f"  Этап: {stage}")
    print(f"  Примерное время: {wait}")
    print("=" * 100)
else:
    print("Ошибка: неизвестный статус заказа.")
